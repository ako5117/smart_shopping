# Copy to .env and fill in. Never commit .env.

# sandbox or production
DARAJA_ENV=sandbox

# From your app on developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=

# Sandbox defaults: shortcode 174379 and the sandbox passkey shown on the Daraja portal
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=

# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Leave empty to use the shortcode. For Till payments, set to the till number.
DARAJA_PARTY_B=

# Public HTTPS base URL where Daraja can reach this service (e.g. an ngrok URL in development)
PUBLIC_BASE_URL=
# Random secret placed in the callback path so only Daraja (who knows the URL) can post results
CALLBACK_SECRET=

# SQLite file for payment records
PAYMENTS_DB_PATH=payments.db
