# Copy to .env and fill in. Never commit .env.

STORE_ID=001
STORE_NAME=Smart Shopping

# Inventory Service (sales) and Payments Service (M-Pesa) base URLs
INVENTORY_URL=http://localhost:8010
PAYMENTS_URL=http://localhost:8000

# Shelf prices until the Product/Pricing Service exists
PRICES_PATH=prices.example.json

# M-Pesa prompts allowed per phone number in 10 minutes
STK_LIMIT_PER_PHONE=3
