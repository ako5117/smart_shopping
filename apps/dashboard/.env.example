# Copy to .env and fill in. Never commit .env.

# Which store this dashboard shows
STORE_ID=001
# Store's local time zone, used for "today" figures
STORE_TZ=Africa/Nairobi

# Inventory Service base URL
INVENTORY_URL=http://localhost:8010

# Shelf Service output (written by `python -m shelf.app --out ...`) and its catalogue
SHELF_EVENTS_PATH=../../services/shelf/shelf_events.jsonl
SHELF_CONFIG_PATH=../../services/shelf/config.example.json

# Products at or below this committed stock are flagged as low
LOW_STOCK_THRESHOLD=5
