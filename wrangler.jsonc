// Cloudflare Worker serving the project docs as a static site.
// `wrangler deploy` runs the build command, then uploads dist/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-shopping",
  "compatibility_date": "2026-09-01",
  "build": {
    "command": "node scripts/build-docs.mjs"
  },
  "assets": {
    "directory": "./dist"
  }
}
