# Front door for the Smart Shopping services.
#   /shop/...       Scan & Go         public (customers' phones)
#   /store/...      Online shop       public
#   /dashboard/...  Store dashboard   any staff login (not riders)
#   /rider/...      Rider app         riders (and managers)
#   /inventory/...  Inventory API     managers only
#   /dispatch/...   Dispatch API      managers only
#   /pay/...        Payments API      managers only, except the M-Pesa callback and the card webhook
#                                     (Daraja and the card provider must reach them)
#   /card-sim/...   Card simulator    demo only (COMPOSE_PROFILES=demo); not running otherwise
# The prefix is stripped before the request reaches the service.
#
# Staff accounts live in deploy/staff/ (users: "name bcrypt-hash", roles: "name manager" or "name rider"), managed with
# scripts/staff.sh. The signed-in name and role are passed to the services as X-Staff-User / X-Staff-Role;
# those headers are always overwritten here, so a browser can't fake them.

{$SITE_ADDRESS} {
	encode gzip

	map {http.auth.user.id} {staff_role} {
		import /etc/caddy/staff/roles
		default staff
	}

	@root path /
	redir @root /shop/ 302

	redir /shop /shop/ 301
	handle_path /shop/* {
		reverse_proxy scan_and_go:8030 {
			header_up -X-Staff-User
			header_up -X-Staff-Role
		}
	}

	redir /store /store/ 301
	handle_path /store/* {
		reverse_proxy storefront:8040 {
			header_up -X-Staff-User
			header_up -X-Staff-Role
		}
	}

	handle_path /pay/payments/mpesa/callback/* {
		rewrite * /payments/mpesa/callback{uri}
		reverse_proxy payments:8000 {
			header_up -X-Staff-User
			header_up -X-Staff-Role
		}
	}

	# The card provider's webhook: signed with the provider's secret key, checked by the Payments Service.
	handle /pay/payments/card/webhook {
		uri strip_prefix /pay
		reverse_proxy payments:8000 {
			header_up -X-Staff-User
			header_up -X-Staff-Role
		}
	}

	handle_path /card-sim/* {
		reverse_proxy card_sim:8098 {
			header_up -X-Staff-User
			header_up -X-Staff-Role
		}
	}

	redir /dashboard /dashboard/ 301
	redir /rider /rider/ 301
	@staff {
		path /pay /pay/* /inventory /inventory/* /dispatch /dispatch/* /dashboard/* /rider/*
		not path /pay/payments/mpesa/callback/* /pay/payments/card/webhook
	}
	basic_auth @staff {
		import /etc/caddy/staff/users
	}

	handle_path /dashboard/* {
		@rider expression `{staff_role} == "rider"`
		respond @rider "Riders use /rider/" 403
		reverse_proxy dashboard:8020 {
			header_up X-Staff-User {http.auth.user.id}
			header_up X-Staff-Role {staff_role}
		}
	}
	handle_path /inventory/* {
		@not_manager expression `{staff_role} != "manager"`
		respond @not_manager "Managers only" 403
		reverse_proxy inventory:8010 {
			header_up X-Staff-User {http.auth.user.id}
			header_up X-Staff-Role {staff_role}
		}
	}
	handle_path /rider/* {
		@not_rider expression `{staff_role} != "rider" && {staff_role} != "manager"`
		respond @not_rider "For riders only" 403
		reverse_proxy rider:8060 {
			header_up X-Staff-User {http.auth.user.id}
			header_up X-Staff-Role {staff_role}
		}
	}
	handle_path /dispatch/* {
		@not_manager expression `{staff_role} != "manager"`
		respond @not_manager "Managers only" 403
		reverse_proxy dispatch:8050 {
			header_up X-Staff-User {http.auth.user.id}
			header_up X-Staff-Role {staff_role}
		}
	}
	handle_path /pay/* {
		@not_manager expression `{staff_role} != "manager"`
		respond @not_manager "Managers only" 403
		reverse_proxy payments:8000 {
			header_up X-Staff-User {http.auth.user.id}
			header_up X-Staff-Role {staff_role}
		}
	}

	handle {
		respond "Not found" 404
	}
}
