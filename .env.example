# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# --- Demo mode: a full purchase without Safaricom -----------------------------------------
# Starts the M-Pesa simulator (tools/mpesa_simulator) and points the Payments Service at it.
# Phone numbers ending 000 cancel, 111 fail (insufficient funds), anything else pays after 3 s.
# For real M-Pesa, remove COMPOSE_PROFILES and set DARAJA_ENV=sandbox (or production) below.
COMPOSE_PROFILES=demo
DARAJA_ENV=simulator

# --- Server -----------------------------------------------------------------------------
# Where the services are served. ":80" for a local demo over http.
# On DigitalOcean, your domain (e.g. shop.example.co.ke); Caddy then gets an HTTPS certificate itself.
SITE_ADDRESS=:80
# Public HTTPS address, used for M-Pesa callbacks (e.g. https://shop.example.co.ke).
# Required for DARAJA_ENV=sandbox or production: the Payments Service won't start without it.
PUBLIC_BASE_URL=

# Required. Password for the shared PostgreSQL database (only the services use it).
# Make one with: openssl rand -hex 24
DB_PASSWORD=

# Staff logins are per person, not in this file: ./scripts/staff.sh add <name> [--manager]

STORE_ID=001
STORE_NAME=Smart Shopping

# M-Pesa (Daraja). Sandbox values from developer.safaricom.co.ke (DARAJA_ENV is set at the top)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Required. Long random string; part of the callback URL so only Daraja can post results.
# Make one with: openssl rand -hex 24
CALLBACK_SECRET=
