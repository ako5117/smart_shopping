# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# --- Demo mode: a full purchase without Safaricom or a card provider ----------------------
# Starts the M-Pesa and card simulators (tools/mpesa_simulator, tools/card_simulator) and points the
# Payments Service at them.
# M-Pesa: phone numbers ending 000 cancel, 111 fail (insufficient funds), anything else pays after 3 s.
# Cards: 4084 0840 8408 4081 pays, 4000 0000 0000 0002 is declined.
# For real payments, remove COMPOSE_PROFILES, set DARAJA_ENV=sandbox (or production) and
# CARD_PROVIDER=paystack (or empty for M-Pesa only) below.
COMPOSE_PROFILES=demo
DARAJA_ENV=simulator
CARD_PROVIDER=simulator

# --- Server -----------------------------------------------------------------------------
# Where the services are served. ":80" for a local demo over http.
# On DigitalOcean, your domain (e.g. shop.example.co.ke); Caddy then gets an HTTPS certificate itself.
SITE_ADDRESS=:80
# Public HTTPS address, used for M-Pesa callbacks (e.g. https://shop.example.co.ke).
# Required for DARAJA_ENV=sandbox or production: the Payments Service won't start without it.
PUBLIC_BASE_URL=

# Required. Password for the shared PostgreSQL database (only the services use it).
# Make one with: openssl rand -hex 24
DB_PASSWORD=

# Staff logins are per person, not in this file: ./scripts/staff.sh add <name> [--manager | --rider]

STORE_ID=001
STORE_NAME=Smart Shopping

# Where riders deliver online orders, and the fee for each area (KES). Empty: a demo list around Nairobi.
DELIVERY_AREAS=

# M-Pesa (Daraja). Sandbox values from developer.safaricom.co.ke (DARAJA_ENV is set at the top)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Required. Long random string; part of the callback URL so only Daraja can post results.
# Make one with: openssl rand -hex 24
CALLBACK_SECRET=

# Cards (Paystack, with CARD_PROVIDER=paystack at the top). The secret key is on the Paystack dashboard
# under Settings > API Keys (sk_test_... for testing, sk_live_... for real money). Set the webhook URL there
# to <PUBLIC_BASE_URL>/pay/payments/card/webhook.
PAYSTACK_SECRET_KEY=
