# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Where the services are served. ":80" for a local demo over http.
# On DigitalOcean, your domain (e.g. shop.example.co.ke); Caddy then gets an HTTPS certificate itself.
SITE_ADDRESS=:80
# Public HTTPS address, used for M-Pesa callbacks (e.g. https://shop.example.co.ke)
PUBLIC_BASE_URL=

# Staff login for the dashboard and service APIs.
# Make the hash with: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# In this file, write every $ in the hash as $$ (Docker Compose would otherwise read it as a variable).
STAFF_USER=staff
STAFF_PASSWORD_HASH=

STORE_ID=001
STORE_NAME=Smart Shopping

# M-Pesa (Daraja). Sandbox values from developer.safaricom.co.ke
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Long random string; part of the callback URL so only Daraja can post results
CALLBACK_SECRET=
