# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# --- Demo mode: a full purchase without Safaricom or a card provider ----------------------
# Starts the M-Pesa and card simulators (tools/mpesa_simulator, tools/card_simulator) and points the
# Payments Service at them.
# M-Pesa: phone numbers ending 000 cancel, 111 fail (insufficient funds), anything else pays after 3 s.
# Cards: 4084 0840 8408 4081 pays, 4000 0000 0000 0002 is declined.
# Texts to customers are recorded but not sent (see them on the dashboard's Online orders page).
# "shelf-sim" adds simulated shelf sensors, for showing the smart-shelf tier (STORE_TIER=smart below).
# For real payments, remove COMPOSE_PROFILES, set DARAJA_ENV=sandbox (or production),
# CARD_PROVIDER=paystack (or empty for M-Pesa only) and SMS_PROVIDER=africastalking (or empty) below.
COMPOSE_PROFILES=demo,shelf-sim
DARAJA_ENV=simulator
CARD_PROVIDER=simulator
SMS_PROVIDER=simulator

# --- Server -----------------------------------------------------------------------------
# Where the services are served. ":80" for a local demo over http.
# On DigitalOcean, your domain (e.g. shop.example.co.ke); Caddy then gets an HTTPS certificate itself.
SITE_ADDRESS=:80
# Public HTTPS address, used for M-Pesa callbacks (e.g. https://shop.example.co.ke).
# Required for DARAJA_ENV=sandbox or production: the Payments Service won't start without it.
PUBLIC_BASE_URL=

# Required. Password for the shared PostgreSQL database (only the services use it).
# Make one with: openssl rand -hex 24
DB_PASSWORD=

# Staff logins are per person, not in this file: ./scripts/staff.sh add <name> [--manager | --rider]

STORE_ID=001
STORE_NAME=Smart Shopping

# Which tier the store runs (docs/tiers.md):
#   standard  no shelf hardware: stock from barcode scans (restocks, sales) and stock counts on the dashboard
#   smart     smart shelves too: live shelf activity, alerts and item locations from the sensors
STORE_TIER=smart

# Delivery (services/dispatch/README.md). The fee goes by distance from the store:
#   scheduled = base + per km x distance, express = scheduled x multiplier (both rounded up to KES 10).
# Further than DELIVERY_MAX_KM, the online shop says so before the customer shops: collect in store instead.
# Empty values use the defaults: base 100, per km 20, express x1.5 (out in about 60 minutes), up to 20 km,
# delivery hours 08-20 local time (STORE_TZ, Africa/Nairobi) in 2-hour slots, road distance = straight line x 1.3.
# The store's location, in decimal degrees, defaults to central Nairobi.
STORE_LAT=
STORE_LNG=
DELIVERY_BASE_KES=
DELIVERY_PER_KM_KES=
DELIVERY_EXPRESS_MULTIPLIER=
DELIVERY_MAX_KM=
DELIVERY_HOURS=
DELIVERY_SLOT_HOURS=
DELIVERY_EXPRESS_MINUTES=
DELIVERY_ROAD_FACTOR=

# M-Pesa (Daraja). Sandbox values from developer.safaricom.co.ke (DARAJA_ENV is set at the top)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
DARAJA_PARTY_B=
# Required. Long random string; part of the callback URL so only Daraja can post results.
# Make one with: openssl rand -hex 24
CALLBACK_SECRET=

# Cards (Paystack, with CARD_PROVIDER=paystack at the top). The secret key is on the Paystack dashboard
# under Settings > API Keys (sk_test_... for testing, sk_live_... for real money). Set the webhook URL there
# to <PUBLIC_BASE_URL>/pay/payments/card/webhook.
PAYSTACK_SECRET_KEY=

# Texts to online customers (Africa's Talking, with SMS_PROVIDER=africastalking at the top): order paid,
# ready to collect, on its way. From your Africa's Talking account: the app's username ("sandbox" for the
# sandbox) and an API key (Settings > API Key). The sender ID is the name texts come from (e.g. MAMAMBOGA),
# once Africa's Talking has approved it; empty uses their shared number.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Returns: unopened, non-perishable items (products not marked perishable on the dashboard) can come back
# within this many days of payment. A manager checks and approves each one; refunds are paid by hand.
RETURN_DAYS=14

# Airport mode (apps/scan_and_go/README.md): STORE_MODE=airport for a shop airside. Travellers scan their
# boarding pass (or type their flight) in Scan & Go instead of signing in, and each sale records who flew where.
#   AIRPORT_CODE: this airport's 3-letter IATA code, e.g. NBO.
#   FLIGHTS_FILE: today's departures as JSON, the stand-in until the airport's flight feed is connected. Empty
#   accepts any flight from this airport today; scan_and_go/demo_flights.json is the demo board.
STORE_MODE=shop
AIRPORT_CODE=
FLIGHTS_FILE=

# Customer accounts and loyalty points (services/customers/README.md). The online shop's Account tab.
#   LOYALTY_ENABLED=false turns points off: accounts and order history keep working, balances are kept.
#   Empty rates use the defaults: 1 point per KES 100 spent; 100 points take KES 50 off an order.
# Email: only the stand-in exists so far. EMAIL_PROVIDER=outbox keeps emails (sign-up and sign-in codes) on
# the dashboard's Loyalty page instead of sending them. Fine for a demo; a live store connects its own email.
LOYALTY_ENABLED=true
LOYALTY_KES_PER_POINT=
LOYALTY_REDEEM_POINTS=
LOYALTY_REDEEM_KES=
EMAIL_PROVIDER=outbox

# Off-site backups to DigitalOcean Spaces (optional): scripts/backup.sh copies each nightly backup here.
# Create the bucket and an access key under Spaces Object Storage on DigitalOcean.
SPACES_BUCKET=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
